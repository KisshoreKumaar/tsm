# AEGIS SOC API. Build from the repository root:  docker build -f deploy/Dockerfile.api -t aegis-api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AEGIS_DB=/data/aegis.db

WORKDIR /srv

COPY backend/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY scripts/ ./scripts/

RUN useradd --system --uid 10001 --home /srv aegis \
    && mkdir -p /data \
    && chown -R aegis:aegis /srv /data
USER aegis
WORKDIR /srv/backend
VOLUME ["/data"]
EXPOSE 8000

# Secrets come from the environment (see .env.example); none are baked into the image.
CMD ["python", "-m", "uvicorn", "--factory", "app.main:create_app", "--host", "0.0.0.0", "--port", "8000"]
