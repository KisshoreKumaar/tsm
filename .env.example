# AEGIS SOC configuration. Run `make init-env` to generate .env with random secrets. Never commit .env.
# Values are literal: no quotes, no shell expansion.

# Admin token (identity "local-admin"); at least 32 random characters.
AEGIS_API_TOKEN=
# Named identities: JSON array of {"name","role","token"}. Roles: viewer, ingest, analyst, detection_engineer, approver, admin.
AEGIS_IDENTITIES=[]
# HMAC key for the audit chain (>= 32 chars). Keep it with your backups; never rotate it for an existing database.
AEGIS_AUDIT_KEY=
# Encrypts provider API keys entered in Settings -> AI Providers (>= 32 chars, different from the audit key).
AEGIS_SECRET_KEY=

# Leave empty to use backend/var/aegis.db
AEGIS_DB=
# Comma-separated feature ids, or "all": core,f1,f2,f3,f4,a3,a5,i1,x1,x2
AEGIS_FEATURES=all
AEGIS_TWO_PERSON=false
AEGIS_RATE_LIMIT=600
AEGIS_CORS_ORIGINS=
AEGIS_CLOCK_SKEW_SECONDS=120
AEGIS_INCIDENT_WINDOW_SECONDS=600
AEGIS_CAMPAIGN_WINDOW_SECONDS=86400
AEGIS_REPLAY_INTERVAL_SECONDS=6
AEGIS_CERT_IN_DEADLINE_HOURS=6

# Optional environment-configured LLM (admins can also add providers and keys in the UI).
AEGIS_LLM_ENABLED=false
AEGIS_LLM_API_TYPE=ollama
AEGIS_LLM_BASE_URL=http://13.235.64.41:11434
AEGIS_LLM_MODEL=aegis-fast
AEGIS_LLM_API_KEY=
AEGIS_LLM_TIMEOUT_S=180
AEGIS_LLM_MAX_OUTPUT_TOKENS=160
AEGIS_LLM_MAX_CONCURRENCY=1
AEGIS_LLM_CONTEXT_TOKENS=2048
AEGIS_LLM_REDACT=true
AEGIS_LLM_ALLOWED_HOSTS=
